# https://editorconfig.org
# Mirrors .prettierrc so editors without the Prettier plugin still match its output.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 110

[*.{ts,js,json}]
quote_type = single

[*.feature]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
