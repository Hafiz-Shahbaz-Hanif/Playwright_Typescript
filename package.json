{
  "name": "playwright-typescript-bdd-framework",
  "version": "1.0.0",
  "description": "UI + API test automation framework built with Playwright, TypeScript and Cucumber BDD on the Page Object Model.",
  "author": "Hafiz Shahbaz Hanif <shahbazhanif87@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bdd": "bddgen",
    "pretest": "bddgen",
    "test": "playwright test",
    "test:ui": "bddgen && playwright test --project=ui-chromium",
    "test:api": "bddgen && playwright test --project=api",
    "test:headed": "bddgen && playwright test --project=ui-chromium --headed",
    "test:all-browsers": "bddgen && playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "allure-commandline": "^2.30.0",
    "allure-js-commons": "^3.0.4",
    "allure-playwright": "^3.0.4",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "playwright": "^1.55.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  }
}
